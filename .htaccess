# Sina & Prestige - Apache Configuration (.htaccess)
# OVH & Production Server Settings

# ========================================
# ENABLE GZIP COMPRESSION
# ========================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ========================================
# BROWSER CACHING
# ========================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Default
  ExpiresDefault "access plus 2 days"

  # HTML
  ExpiresByType text/html "access plus 2 hours"

  # CSS
  ExpiresByType text/css "access plus 1 month"

  # JavaScript
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/truetype "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/x-font-opentype "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/x-font-woff2 "access plus 1 year"

  # JSON
  ExpiresByType application/json "access plus 1 month"
</IfModule>

# ========================================
# ETAG FOR CACHE VALIDATION
# ========================================
<IfModule mod_headers.c>
  Header unset ETag
  FileETag None
</IfModule>

# ========================================
# SECURITY HEADERS
# ========================================
<IfModule mod_headers.c>
  # Content Security Policy
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"

  # X-Frame-Options (clickjacking protection)
  Header set X-Frame-Options "SAMEORIGIN"

  # X-Content-Type-Options (MIME type sniffing)
  Header set X-Content-Type-Options "nosniff"

  # X-XSS-Protection (XSS protection)
  Header set X-XSS-Protection "1; mode=block"

  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy
  Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
</IfModule>

# ========================================
# DISABLE DIRECTORY LISTING
# ========================================
Options -Indexes


# Canonical P01-P23 URLs — legacy clean URLs
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^formations/?$ /p02-formations [R=301,L]
RewriteRule ^calendrier-formations/?$ /p03-calendrier-inscriptions [R=301,L]
RewriteRule ^recrutement/?$ /p04-recrutement-rh [R=301,L]
RewriteRule ^accompagnement-rh/?$ /p04-recrutement-rh [R=301,L]
RewriteRule ^entreprise/?$ /p05-entreprises [R=301,L]
RewriteRule ^publics/?$ /p06-employabilite [R=301,L]
RewriteRule ^ia-emploi-insertion/?$ /p06-employabilite [R=301,L]
RewriteRule ^evenements/?$ /p10-evenements-masterclass [R=301,L]
RewriteRule ^webinaires-masterclass/?$ /p10-evenements-masterclass [R=301,L]
RewriteRule ^univers/?$ /p11-expertises [R=301,L]
RewriteRule ^a-propos/?$ /p13-a-propos [R=301,L]
RewriteRule ^fondatrice/?$ /p14-fondatrice-interview [R=301,L]
RewriteRule ^ressources/?$ /p18-ressources-videos [R=301,L]
RewriteRule ^videos/?$ /p18-ressources-videos [R=301,L]
RewriteRule ^catalogues-plaquettes/?$ /p19-catalogues-programmes [R=301,L]
RewriteRule ^qualite/?$ /p20-qualite-qualiopi-accessibilite [R=301,L]
RewriteRule ^qualite-accessibilite/?$ /p20-qualite-qualiopi-accessibilite [R=301,L]
RewriteRule ^temoignages/?$ /p16-presse-medias [R=301,L]
RewriteRule ^presse/?$ /p16-presse-medias [R=301,L]
RewriteRule ^articles/?$ /p17-articles-blog [R=301,L]
RewriteRule ^contact/?$ /p22-contact [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ========================================
# REWRITE RULES
# ========================================
# For localhost development, use: python server.py
# This enables clean URLs without .html extension
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteBase /
#   RewriteCond %{REQUEST_FILENAME} !-f
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteCond %{REQUEST_FILENAME}\.html -f
#   RewriteRule ^(.+?)/?$ $1.html [L]
# </IfModule>

# ========================================
# PREVENT ACCESS TO SENSITIVE FILES
# ========================================
<FilesMatch "\.(env|json|lock|bak|orig|sql)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ========================================
# CHARSET ENCODING
# ========================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .webmanifest

# ========================================
# MIME TYPES
# ========================================
<IfModule mod_mime.c>
  AddType application/x-javascript .js
  AddType text/css .css
  AddType image/webp .webp
  AddType application/x-font-woff .woff
  AddType application/x-font-woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddEncoding gzip .gz
</IfModule>
