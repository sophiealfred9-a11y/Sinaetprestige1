# Sina & Prestige - Apache Configuration (.htaccess)
# OVH & Production Server Settings

# ========================================
# ENABLE GZIP COMPRESSION
# ========================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ========================================
# BROWSER CACHING & REVALIDATION
# ========================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Default
  ExpiresDefault "access plus 0 seconds"

  # HTML - Always revalidate
  ExpiresByType text/html "access plus 0 seconds"

  # CSS & JavaScript - Revalidate with ETag
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"

  # Images
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/gif "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType image/x-icon "access plus 1 day"

  # Fonts
  ExpiresByType font/truetype "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/x-font-opentype "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/x-font-woff2 "access plus 1 year"

  # JSON
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ========================================
# ETAG & CACHE-CONTROL HEADERS
# ========================================
<IfModule mod_headers.c>
  # Enable ETag for cache validation
  FileETag MTime Size

  # Force HTML to never store / always revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Force CSS & JS to revalidate with server on every request
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ========================================
# SECURITY HEADERS
# ========================================
<IfModule mod_headers.c>
  # Content Security Policy
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"

  # X-Frame-Options (clickjacking protection)
  Header set X-Frame-Options "SAMEORIGIN"

  # X-Content-Type-Options (MIME type sniffing)
  Header set X-Content-Type-Options "nosniff"

  # X-XSS-Protection (XSS protection)
  Header set X-XSS-Protection "1; mode=block"

  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy
  Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
</IfModule>

# ========================================
# DISABLE DIRECTORY LISTING
# ========================================
Options -Indexes


# Canonical P01-P23 URLs — legacy clean URLs
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^formations/?$ /formations.html [R=301,L]
RewriteRule ^calendrier-formations/?$ /calendrier-formations.html [R=301,L]
RewriteRule ^recrutement/?$ /recrutement.html [R=301,L]
RewriteRule ^accompagnement-rh/?$ /recrutement.html [R=301,L]
RewriteRule ^entreprise/?$ /entreprise.html [R=301,L]
RewriteRule ^publics/?$ /publics.html [R=301,L]
RewriteRule ^ia-emploi-insertion/?$ /employabilite.html [R=301,L]
RewriteRule ^evenements/?$ /webinaires-masterclass.html [R=301,L]
RewriteRule ^webinaires-masterclass/?$ /webinaires-masterclass.html [R=301,L]
RewriteRule ^univers/?$ /univers.html [R=301,L]
RewriteRule ^a-propos/?$ /a-propos.html [R=301,L]
RewriteRule ^fondatrice/?$ /fondatrice.html [R=301,L]
RewriteRule ^ressources/?$ /videos.html [R=301,L]
RewriteRule ^videos/?$ /videos.html [R=301,L]
RewriteRule ^catalogues-plaquettes/?$ /catalogues-plaquettes.html [R=301,L]
RewriteRule ^qualite/?$ /qualite-accessibilite.html [R=301,L]
RewriteRule ^qualite-accessibilite/?$ /qualite-accessibilite.html [R=301,L]
RewriteRule ^temoignages/?$ /presse.html [R=301,L]
RewriteRule ^presse/?$ /presse.html [R=301,L]
RewriteRule ^articles/?$ /articles.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ========================================
# REWRITE RULES
# ========================================
# For localhost development, use: python server.py
# This enables clean URLs without .html extension
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteBase /
#   RewriteCond %{REQUEST_FILENAME} !-f
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteCond %{REQUEST_FILENAME}\.html -f
#   RewriteRule ^(.+?)/?$ $1.html [L]
# </IfModule>

# ========================================
# PREVENT ACCESS TO SENSITIVE FILES
# ========================================
<FilesMatch "\.(env|json|lock|bak|orig|sql)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ========================================
# CHARSET ENCODING
# ========================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .webmanifest

# ========================================
# MIME TYPES
# ========================================
<IfModule mod_mime.c>
  AddType application/x-javascript .js
  AddType text/css .css
  AddType image/webp .webp
  AddType application/x-font-woff .woff
  AddType application/x-font-woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddEncoding gzip .gz
</IfModule>
